{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vispek-hc:schema:calibration-1",
  "title": "calibration.json of a vispek-hc calibration folder",
  "type": "object",
  "required": [
    "schema",
    "calibration_id",
    "created_at_utc",
    "software",
    "inputs",
    "binding",
    "white_roi",
    "white_roi_px",
    "denominator_floor",
    "dominant_channel_by_led",
    "quality",
    "linearisation"
  ],
  "properties": {
    "schema": {
      "const": "vispek-hc.calibration/1"
    },
    "calibration_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at_utc": {
      "type": "string"
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "capture_id",
          "capture_json_sha256",
          "group_ids"
        ]
      }
    },
    "binding": {
      "type": "object",
      "required": [
        "unit_id",
        "channels",
        "pwm_by_led",
        "min_on_by_led",
        "exposure",
        "gain",
        "actual_size",
        "reduction",
        "camera_controls_values"
      ],
      "properties": {
        "channels": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "reduction": {
          "enum": [
            "dominant",
            "luma"
          ]
        },
        "pwm_by_led": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[0-9]+$"
          }
        },
        "min_on_by_led": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[0-9]+$"
          }
        },
        "camera_controls_values": {
          "type": "object"
        }
      }
    },
    "white_roi": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        }
      ]
    },
    "white_roi_px": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "x0",
            "y0",
            "x1",
            "y1"
          ]
        }
      ]
    },
    "denominator_floor": {
      "type": "object",
      "required": [
        "absolute_dn",
        "relative"
      ]
    },
    "dominant_channel_by_led": {
      "type": "object",
      "patternProperties": {
        "^[0-9]+$": {
          "enum": [
            "R",
            "G",
            "B"
          ]
        }
      },
      "additionalProperties": false
    },
    "quality": {
      "type": "object",
      "required": [
        "region",
        "gates",
        "bands",
        "warnings"
      ],
      "properties": {
        "region": {
          "enum": [
            "roi",
            "frame"
          ]
        },
        "bands": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "band_id",
              "valid_fraction",
              "saturated_fraction",
              "white_signal_median",
              "dark_median",
              "dark_p99",
              "pass"
            ]
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "linearisation": {
      "type": "null"
    },
    "software": {
      "type": "object",
      "required": [
        "name",
        "version"
      ]
    }
  }
}
